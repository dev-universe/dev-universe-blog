---
import '../styles/global.css';
const { title='DEV UNIVERSE — 만드는 과정의 기록', description='universe의 기술 블로그. 웹 개발, 인프라, AI 도구를 직접 만들고 검증하며 남기는 기록.' }=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><meta name="author" content="universe"/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL('/og.svg',Astro.site)}/><meta name="theme-color" content="#f5f4ef"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="alternate" type="application/rss+xml" title="DEV UNIVERSE" href="/rss.xml"/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script></head>
<body><a class="skip" href="#main">본문 바로가기</a><header class="site-header wrap"><a class="wordmark" href="/" aria-label="DEV UNIVERSE 홈"><span class="mark">✳</span> DEV UNIVERSE<span class="dot">.</span></a><nav aria-label="메인 메뉴"><a href="/#writing">글</a><a href="/about/">소개</a><a href="https://github.com/dev-universe/dev-universe-blog" target="_blank" rel="noopener noreferrer">GitHub ↗</a><button id="theme" aria-label="색상 테마 전환" title="색상 테마 전환">◐</button></nav></header>
<main id="main"><slot/></main><footer class="wrap"><div><a class="footer-brand" href="/">DEV UNIVERSE.</a><p>작게 만들고, 깊이 이해하고, 꾸준히 기록합니다.</p></div><div class="footer-right"><a href="/rss.xml">RSS ↗</a><a href="https://github.com/dev-universe">GitHub ↗</a><span>© {new Date().getFullYear()} universe</span></div></footer>
<script>document.querySelector('#theme')?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;try{localStorage.setItem('theme',next)}catch{}});</script></body></html>
