---
import Base from '../../layouts/Base.astro';
import {posts,date,minutes} from '../../lib/posts';
import {render} from 'astro:content';
export async function getStaticPaths(){return (await posts()).map(post=>({params:{id:post.id},props:{post}}))}
const {post}=Astro.props;const {Content,headings}=await render(post);
const url=new URL(`/posts/${post.id}/`,Astro.site).href;
const author={'@type':'Person','@id':new URL('/about/#author',Astro.site).href,name:'universe',url:new URL('/about/',Astro.site).href};
const article={published:post.data.date.toISOString(),modified:(post.data.updated??post.data.date).toISOString()};
const schema=[{'@type':'BlogPosting','@id':url+'#article',url,mainEntityOfPage:url,headline:post.data.title,description:post.data.description,abstract:post.data.summary,datePublished:article.published,dateModified:article.modified,author,inLanguage:'ko-KR',articleSection:post.data.category,keywords:post.data.tags,image:new URL('/og.png',Astro.site).href,isPartOf:{'@id':new URL('/#website',Astro.site).href}},
{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'홈',item:Astro.site?.href},{'@type':'ListItem',position:2,name:post.data.title,item:url}]}];
const related=(await posts()).filter(p=>p.id!==post.id).sort((a,b)=>Number(b.data.category===post.data.category)-Number(a.data.category===post.data.category)).slice(0,2);
---
<Base article={article} schema={schema} title={post.data.title+' — DEV UNIVERSE'} description={post.data.description}><article class="wrap article"><nav aria-label="현재 위치"><a class="back" href="/">홈</a><span aria-hidden="true"> / </span><span>글</span></nav><header class="article-header"><span class="tag">{post.data.category}</span><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="meta"><a href="/about/" rel="author">universe</a><span>·</span><time datetime={post.data.date.toISOString()}>{date(post.data.date)}</time><span>·</span><span>{minutes(post.body)}분 읽기</span>{post.data.updated && <time datetime={article.modified}>수정 {date(post.data.updated)}</time>}</div></header><div class="article-grid"><div class="prose"><section class="article-summary" aria-label="핵심 요약"><strong>핵심 요약</strong><p>{post.data.summary}</p></section><Content/><div class="article-end"><a href="/about/" rel="author">기록한 사람 · universe</a><a href="/#writing">다른 글 읽기 ↗</a></div><section aria-label="함께 읽기"><h2>함께 읽기</h2><ul>{related.map(item=><li><a href={`/posts/${item.id}/`}>{item.data.title}</a></li>)}</ul></section></div><aside><p class="eyebrow">ON THIS PAGE</p><nav aria-label="목차">{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</nav></aside></div></article></Base>
